# Server
NODE_ENV=development
PORT=3000
# Public origin the app is served from (used to build webhook/redirect URLs)
PUBLIC_URL=http://localhost:3000

# Database (MySQL-compatible, e.g. TiDB Cloud, PlanetScale, Railway MySQL)
DATABASE_URL=mysql://user:password@host:3306/database

# Admin session signing secret (any long random string)
JWT_SECRET=

# HitPay payment gateway (https://www.hitpay.com)
HITPAY_API_KEY=
HITPAY_API_URL=https://api.sandbox.hit-pay.com
HITPAY_SALT=

# OneMap (https://www.onemap.gov.sg/apidocs/) - free, used for delivery fee
# calculation. With email + password the server renews its own 3-day API token.
# (ONEMAP_API_EMAIL / ONEMAP_API_PASSWORD are accepted as alternative names.)
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
# Optional alternative to email/password: a pasted token, valid for 3 days only.
ONEMAP_TOKEN=

# Google Maps (Distance Matrix API) - optional last-resort fallback for delivery fees
GOOGLE_MAPS_API_KEY=

# Resend (https://resend.com) - sends the payment-confirmation email
RESEND_API_KEY=
# Must be a verified sender/domain in your Resend account. The onboarding@resend.dev
# sandbox sender works with no verification for initial testing.
ORDER_EMAIL_FROM=Joyous JellyArt <onboarding@resend.dev>

# Vercel Blob (https://vercel.com/docs/vercel-blob) - stores customer-uploaded
# reference images from the Customize wizard. Enable "Blob" storage for this
# project in the Vercel dashboard (Storage tab) and copy the token it gives
# you; locally, run `vercel env pull` or copy it from the dashboard.
BLOB_READ_WRITE_TOKEN=
