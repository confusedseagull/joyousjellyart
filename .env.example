# Server
NODE_ENV=development
PORT=3000
# Public origin the app is served from (used to build webhook/redirect URLs)
PUBLIC_URL=http://localhost:3000

# Database (MySQL-compatible, e.g. TiDB Cloud, PlanetScale, Railway MySQL)
DATABASE_URL=mysql://user:password@host:3306/database

# Admin session signing secret (any long random string)
JWT_SECRET=

# HitPay payment gateway (https://www.hitpay.com)
HITPAY_API_KEY=
HITPAY_API_URL=https://api.sandbox.hit-pay.com
HITPAY_SALT=

# Google Maps (Distance Matrix API, used for delivery fee calculation)
GOOGLE_MAPS_API_KEY=
